# ==============================================================================
# Saarthi Environment Configuration Template
# Copy this file to .env and fill in your actual credentials.
# DO NOT commit .env with real secrets to version control.
# ==============================================================================

# Database Connection (Neon PostgreSQL / Local Postgres)
NEXT_PUBLIC_NEON_DB_CONNECTION_STRING=postgresql://user:password@host.neon.tech/neondb?sslmode=require

# Clerk Authentication
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_YOUR_CLERK_PUBLISHABLE_KEY
CLERK_SECRET_KEY=sk_test_YOUR_CLERK_SECRET_KEY
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/

# Groq AI SDK
GROQ_API_KEY=gsk_YOUR_GROQ_API_KEY

# AWS Bedrock & S3 Storage
MY_AWS_REGION=us-east-1
MY_AWS_ACCESS_KEY_ID=AKIA_YOUR_AWS_ACCESS_KEY
MY_AWS_SECRET_ACCESS_KEY=YOUR_AWS_SECRET_ACCESS_KEY
MY_AWS_S3_BUCKET_NAME=saarthi-resumes-bucket

# YouTube Data API
YOUTUBE_API_KEY=AIza_YOUR_YOUTUBE_API_KEY

# Inngest Background Worker
INNGEST_SIGNING_KEY=local.dev
INNGEST_SERVER_HOST=http://127.0.0.1:8288

# Cloud Playwright Engine (Optional)
BROWSERBASE_API_KEY=your_browserbase_api_key
BROWSERBASE_PROJECT_ID=your_browserbase_project_id
